# openGym 配置模板 —— 复制为 .env 后填写（cp .env.example .env）
# 全部变量均为可选，缺省时使用代码内置默认值

# Web 对外端口，默认 8080
# WEB_PORT=8080

# 服务地址（部署时改为你的域名或 IP；登录 Cookie 的 Secure 属性依赖 https）
# ORIGIN=http://localhost:8080

# 邮箱验证码登录（必配：SMTP 服务商参数）
# 使用 foxmail / QQ 邮箱时：SMTP_HOST=smtp.qq.com SMTP_PORT=465
# SMTP_PASS 填的是邮箱的「授权码」，不是登录密码。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 管理员邮箱（逗号分隔，多个管理员用英文逗号隔开）。
# 管理员邮箱注册时免邀请码，并自动获得后台「数据面板」权限。
ADMIN_EMAILS=

# 后台管理系统的登录密码（配合 ADMIN_EMAILS 中的邮箱使用）。
# 与主站邮箱验证码登录完全隔离，请务必修改为强密码！
ADMIN_PASSWORD=

# 邀请制开关：默认开启，非管理员邮箱注册必须持有有效邀请码
# INVITE_ONLY=1

# 会话有效期（天），默认 90
# SESSION_DAYS=90
