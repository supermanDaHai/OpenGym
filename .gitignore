node_modules/
**/node_modules/
frontend/dist/
api/node_modules/
*.tsbuildinfo

# ---- 工具目录与日志 ----
.workbuddy/
logs/
*.log
npm-debug.log*

# ---- 操作系统与编辑器 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
